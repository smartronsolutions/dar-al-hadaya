<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
<template id="dar_al_hadaya_home" inherit_id="website.homepage" name="Dar Al Hadaya Home">
    <xpath expr="//div[@id='wrap']" position="replace">
        <div id="wrap" class="dah_page dah_home">
            <t t-set="dah_products" t-value="request.env['product.template'].sudo().search(website.sale_product_domain(), order='website_sequence, id')"/>
            <t t-set="dah_new_products" t-value="request.env['product.template'].sudo().search(website.sale_product_domain(), order='create_date desc, id desc', limit=16)"/>
            <t t-set="dah_featured" t-value="dah_products.filtered('dah_featured')[:2] or dah_products[:2]"/>
            <t t-set="dah_categories" t-value="request.env['product.public.category'].sudo().search([('dah_for_dar_al_hadaya', '=', True), ('website_id', 'in', [False, website.id])], order='sequence, id')"/>
            <t t-set="dah_new_baby" t-value="dah_categories.filtered(lambda category: category.name == 'Newborn &amp; Baby Gifts')[:1]"/>

            <!-- Responsive autoplay hero carousel using the supplied banner assets. -->
            <section class="dah_home_hero" aria-label="Gifts made personal">
                <div class="dah_hero_slider" id="dah_hero_slider">
                    <article class="dah_hero_slide dah_hero_slide_active">
                        <a href="/shop" class="dah_home_banner_link"><img src="/dar_al_hadaya/static/src/img/banners/banner1.png" alt="Gifts Made Personal" width="1959" height="803" loading="eager" fetchpriority="high"/></a>
                    </article>
                    <article class="dah_hero_slide">
                        <a href="/shop" class="dah_home_banner_link"><img src="/dar_al_hadaya/static/src/img/banners/banner1.2.png" alt="Thoughtful Gifts for Her" width="1774" height="887" loading="lazy"/></a>
                    </article>
                    <article class="dah_hero_slide">
                        <a href="/shop" class="dah_home_banner_link"><img src="/dar_al_hadaya/static/src/img/banners/banner1.3.png" alt="Beautiful Gifts for Every Her" width="1774" height="887" loading="lazy"/></a>
                    </article>
                    <button type="button" class="dah_hero_arrow dah_hero_prev" id="dah_hero_prev" aria-label="Previous banner">&#8249;</button>
                    <button type="button" class="dah_hero_arrow dah_hero_next" id="dah_hero_next" aria-label="Next banner">&#8250;</button>
                </div>
                <div class="dah_hero_dots" id="dah_hero_dots" aria-label="Choose banner">
                    <button type="button" class="dah_hero_dot dah_hero_dot_active" data-index="0" aria-label="Banner 1"/>
                    <button type="button" class="dah_hero_dot" data-index="1" aria-label="Banner 2"/>
                    <button type="button" class="dah_hero_dot" data-index="2" aria-label="Banner 3"/>
                </div>
            </section>

            <section class="dah_section dah_categories" id="dah_categories">
                <div class="dah_section_head"><h2>Shop by Category</h2></div>
                <div class="dah_category_rail">
                    <div class="dah_cat_scroll" id="dah_cat_scroll">
                    <t t-if="dah_categories">
                        <a class="dah_cat_tile" t-foreach="dah_categories" t-as="category" t-att-href="'/shop/category/' + slug(category)">
                            <span class="dah_cat_tile_media">
                                <img t-if="category.image_1920" t-att-src="website.image_url(category, 'image_512')" t-att-alt="category.name" loading="lazy"/>
                                <span t-else="" class="dah_cat_fallback" t-esc="category.name[:1]"/>
                            </span>
                            <span class="dah_cat_tile_name" t-esc="category.name"/>
                        </a>
                    </t>
                    <div class="dah_empty_hint" t-else="">Add categories from Dar Al Hadaya → Categories.</div>
                    </div>
                </div>
            </section>

            <section class="dah_section dah_home_products">
                <div class="dah_section_head"><h2>Our Products</h2></div>
                <div class="dah_home_product_grid">
                    <t t-foreach="dah_new_products" t-as="product">
                        <t t-call="dar_al_hadaya.product_card">
                            <t t-set="product" t-value="product"/>
                        </t>
                    </t>
                </div>
                <div class="dah_home_view_all">
                    <a class="dah_btn dah_btn_cta" href="/shop">View All</a>
                </div>
            </section>

            <section class="dah_section dah_process">
                <div class="dah_section_head"><h2>How It Works</h2></div>
                <div class="dah_steps">
                    <div class="dah_step"><span class="dah_step_icon"><i class="fa fa-gift"/></span><span class="dah_step_num">1</span><h3>Choose your gift</h3></div>
                    <span class="dah_step_arrow" aria-hidden="true">&#8594;</span>
                    <div class="dah_step"><span class="dah_step_icon"><i class="fa fa-file-text-o"/></span><span class="dah_step_num">2</span><h3>Place your order</h3></div>
                    <span class="dah_step_arrow" aria-hidden="true">&#8594;</span>
                    <div class="dah_step"><span class="dah_step_icon"><i class="fa fa-whatsapp"/></span><span class="dah_step_num">3</span><h3>We complete order in WhatsApp</h3></div>
                </div>
            </section>
        </div>
    </xpath>
</template>

<template id="dar_al_hadaya.product_card" name="Dar Al Hadaya Product Card">
    <div class="dah_product_card" t-att-data-product-id="product.product_variant_id.id">
        <a class="dah_product_media" t-att-href="product.website_url"><img t-att-src="website.image_url(product, 'image_512')" t-att-alt="product.name" loading="lazy"/></a>
        <div class="dah_product_info">
            <a class="dah_product_text_link" t-att-href="product.website_url">
                <h3 t-esc="product.name"/>
                <div class="dah_product_price" t-esc="product.currency_id.format(product.list_price)"/>
            </a>
            <a class="dah_btn dah_btn_order" t-att-href="product.website_url">
                <i class="fa fa-shopping-bag" aria-hidden="true"/>
                <span>ORDER NOW</span>
            </a>
        </div>
    </div>
</template>
</data>
</odoo>
