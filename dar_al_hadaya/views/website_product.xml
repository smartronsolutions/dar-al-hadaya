<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

<!-- ══════════════════════════════════════════════════════════════════
     DAR AL HADAYA PRODUCT PAGE
     Recreates the reference e-commerce product page with the
     #132254 / #f6f5f2 palette:

       1. Breadcrumb (kept from the standard website_sale.product)
       2. Gallery: main image + left thumbnail rail (carousel + indicators)
       3. Details: title, rating + SKU, price, short description,
          product-specific customization instructions + Color Theme,
          quantity, ADD TO CART, delivery info
       4. Tabs: Description / Details / Shipping &amp; Returns / Reviews
       5. "You May Also Like" alternative products (restyled in CSS)

     The standard Odoo add-to-cart form is left intact so the existing
     cart/order sidebar still works.
     ══════════════════════════════════════════════════════════════════ -->

<!-- ── 1. Gallery: always use the carousel (reference shows thumbnails) ── -->
<template id="dar_al_hadaya_product_images" inherit_id="website_sale.shop_product_images" name="Dar Al Hadaya Product Images">
    <xpath expr="//t[@t-call='website_sale.shop_product_#{website.product_page_image_layout}']" position="replace">
        <t t-call="website_sale.shop_product_carousel"/>
    </xpath>
</template>

<!-- Render the optional YouTube video as the first product-detail gallery item. -->
<template id="dar_al_hadaya_product_video_carousel" inherit_id="website_sale.shop_product_carousel" name="Dar Al Hadaya Product Video First">
    <xpath expr="//t[@t-set='product_carousel_block_name']" position="before">
        <t t-set="dah_video_data" t-value="product._dah_video_data()"/>
        <t t-set="dah_video_embed_url" t-value="dah_video_data and dah_video_data['url']"/>
    </xpath>
    <xpath expr="//div[hasclass('carousel-inner')]/t[@t-foreach='product_images']" position="before">
        <div t-if="dah_video_embed_url" class="carousel-item dah-product-video-slide h-100 w-100 text-center active">
            <div class="dah-product-video-frame">
                <video t-if="dah_video_data['type'] == 'upload'"
                       t-att-src="dah_video_embed_url"
                       autoplay="autoplay" muted="muted" loop="loop"
                       playsinline="playsinline" controls="controls"
                       preload="metadata"></video>
                <iframe t-else=""
                        t-att-src="dah_video_embed_url"
                        t-att-title="'%s video' % product.name"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen="allowfullscreen"
                        referrerpolicy="strict-origin-when-cross-origin"
                        loading="eager"></iframe>
            </div>
        </div>
    </xpath>
    <xpath expr="//div[hasclass('carousel-inner')]/t[@t-foreach='product_images']/div" position="attributes">
        <attribute name="t-attf-class">carousel-item h-100 w-100 text-center#{' active' if product_image_first and not dah_video_embed_url else ''}</attribute>
    </xpath>
    <xpath expr="//div[hasclass('o_carousel_product_outer')]/t[@t-if='len(product_images) &gt; 1']" position="attributes">
        <attribute name="t-if">dah_video_embed_url or len(product_images) &gt; 1</attribute>
    </xpath>
</template>

<template id="dar_al_hadaya_product_video_indicators" inherit_id="website_sale.carousel_product_indicators" name="Dar Al Hadaya Product Video Indicator">
    <xpath expr="//div[@t-ignore='True']" position="attributes">
        <attribute name="t-if">dah_video_embed_url or len(product_images) &gt; 1</attribute>
    </xpath>
    <xpath expr="//div[@t-ignore='True']/ol/li[@t-foreach='product_images']" position="before">
        <li t-if="dah_video_embed_url"
            class="align-top position-relative active dah-product-video-indicator"
            data-bs-target="#o-carousel-product"
            data-bs-slide-to="0"
            aria-label="Play product video">
            <i class="fa fa-play-circle" aria-hidden="true"></i>
        </li>
    </xpath>
    <xpath expr="//div[@t-ignore='True']/ol/li[@t-foreach='product_images']" position="attributes">
        <attribute name="t-attf-class">align-top position-relative {{'active' if product_image_first and not dah_video_embed_url else ''}}</attribute>
        <attribute name="t-att-data-bs-slide-to">str(product_image_index + (1 if dah_video_embed_url else 0))</attribute>
    </xpath>
</template>

<!-- ── 2. Gallery: vertical thumbnail rail on the left of the main image ── -->
<!-- ── 3. SKU straight under the product title ── -->
<template id="dar_al_hadaya_product_title" inherit_id="website_sale.product_title" name="Dar Al Hadaya Product Title">
    <xpath expr="//h1[@t-field='product.name']" position="after">
        <div class="dah-product-sku" t-if="product.default_code or product_variant.default_code">
            SKU: <span t-esc="product.default_code or product_variant.default_code"/>
        </div>
        <div class="dah-product-short-intro" t-if="product.dah_short_description and not is_html_empty(product.dah_short_description)">
            <t t-out="product.dah_short_description"/>
        </div>
    </xpath>
</template>

<!-- ── 4. Product details rework ── -->
<template id="dar_al_hadaya_product" inherit_id="website_sale.product" name="Dar Al Hadaya Product Page">
    <!-- Clean product breadcrumb and remove the public pricelist selector. -->
    <xpath expr="//ol[hasclass('o_wsale_breadcrumb')]" position="replace"/>
    <xpath expr="//t[@t-call='website_sale.pricelist_list']" position="replace"/>

    <!-- Personalization options, just above the CTA -->
    <xpath expr="//div[hasclass('o_wsale_product_details_content_section_cta')]" position="before">
        <div class="dah-product-personalize">
            <h4>Customize Your Product</h4>

            <div class="dah-product-field">
                <label for="dah_color_picker">Choose Color</label>
                <div class="dah-color-picker-field">
                    <input type="color" id="dah_color_picker" name="dah_color_theme" value="#132254" aria-label="Choose customization color"/>
                    <span id="dah_color_value">#132254</span>
                </div>
                <small class="dah-product-field-hint">Tap the color box and select your preferred color.</small>
            </div>

            <div class="dah-product-field">
                <label for="dah_customization">Describe Customization</label>
                <textarea id="dah_customization" name="dah_customization" rows="3"
                          placeholder="Describe exactly what you want, including text, name, date, style or any special instructions."
                          autocomplete="off"></textarea>
                <small class="dah-product-field-hint">Tell us how you want your product to be made.</small>
            </div>
        </div>
    </xpath>

    <!-- The full description now lives in the Description tab, so hide it here -->
    <xpath expr="//div[@id='product_full_description']" position="attributes">
        <attribute name="class" add="d-none" separator=" "/>
    </xpath>

    <!-- Tabs: Description / Details / Shipping &amp; Returns / Reviews -->
    <xpath expr="//section[@id='product_detail']" position="after">
        <div class="dah_fixed_order_bar" id="dah_fixed_order_bar" aria-hidden="true">
            <button type="button" class="dah_mobile_sticky_cart" id="dah_mobile_sticky_cart">
                <i class="fa fa-shopping-cart" aria-hidden="true"></i>
                <span>Add to Cart</span>
            </button>
            <button type="button" class="dah_mobile_sticky_whatsapp" id="dah_mobile_sticky_whatsapp">
                <i class="fa fa-whatsapp" aria-hidden="true"></i>
                <span>Order by WhatsApp</span>
            </button>
        </div>
        <section class="dah-product-tabs container" id="dah_product_tabs" aria-label="Product information">
            <t t-set="dah_review_stats" t-value="product.dah_review_stats()"/>
            <ul class="nav nav-tabs dah-product-tabs-nav" id="dah_tabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="dah-tab-description" data-bs-toggle="tab" data-bs-target="#dah-panel-description" type="button" role="tab" aria-controls="dah-panel-description" aria-selected="true">Description</button>
                </li>
                <li t-if="product.dah_details_contents and not is_html_empty(product.dah_details_contents)" class="nav-item" role="presentation">
                    <button class="nav-link" id="dah-tab-details" data-bs-toggle="tab" data-bs-target="#dah-panel-details" type="button" role="tab" aria-controls="dah-panel-details" aria-selected="false">Details</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="dah-tab-shipping" data-bs-toggle="tab" data-bs-target="#dah-panel-shipping" type="button" role="tab" aria-controls="dah-panel-shipping" aria-selected="false">Shipping &amp; Returns</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="dah-tab-reviews" data-bs-toggle="tab" data-bs-target="#dah-panel-reviews" type="button" role="tab" aria-controls="dah-panel-reviews" aria-selected="false">Reviews <span t-if="dah_review_stats['count']">(<t t-esc="dah_review_stats['count']"/>)</span></button>
                </li>
            </ul>

            <div class="tab-content dah-product-tabs-content" id="dah_tabs_content">
                <div class="tab-pane fade show active" id="dah-panel-description" role="tabpanel" aria-labelledby="dah-tab-description">
                    <div class="dah-product-description" t-if="product.website_description and not is_html_empty(product.website_description)">
                        <t t-out="product.website_description"/>
                    </div>
                    <div class="dah-product-description" t-elif="product.description_ecommerce and not is_html_empty(product.description_ecommerce)">
                        <t t-out="product.description_ecommerce"/>
                    </div>
                    <div class="dah-product-description" t-elif="product.dah_details_contents and not is_html_empty(product.dah_details_contents)">
                        <t t-out="product.dah_details_contents"/>
                    </div>
                </div>

                <div class="tab-pane fade" id="dah-panel-details" role="tabpanel" aria-labelledby="dah-tab-details">
                    <div class="dah-product-description" t-out="product.dah_details_contents" t-if="product.dah_details_contents and not is_html_empty(product.dah_details_contents)"/>
                </div>

                <div class="tab-pane fade" id="dah-panel-shipping" role="tabpanel" aria-labelledby="dah-tab-shipping">
                    <div class="dah-product-delivery dah-product-delivery--tab">
                        <div class="dah-product-delivery-item">
                            <i class="fa fa-phone" aria-hidden="true"></i>
                            <span>Estimated Delivery: 2-3 working days</span>
                        </div>
                        <div class="dah-product-delivery-item">
                            <i class="fa fa-truck" aria-hidden="true"></i>
                            <span>Free delivery on orders above QAR 200</span>
                        </div>
                        <a class="dah-product-wa" href="https://wa.me/97433344765"
                           t-att-data-dah-product-name="product.name" target="_blank" rel="noopener">
                            <i class="fa fa-whatsapp" aria-hidden="true"></i> Chat on WhatsApp
                        </a>
                    </div>
                    <div class="dah-product-description">
                        <p>Orders are carefully inspected, packaged and dispatched within 2-3 working days.</p>
                        <p>Free delivery is available on all orders above QAR 200. For orders below this amount a delivery fee applies and is shown at checkout.</p>
                        <p>If you are not completely satisfied with your order, we accept returns within 14 days of delivery, provided the item is unused and in its original packaging. Personalized items cannot be returned, except in case of damage or a production error.</p>
                    </div>
                </div>

                <div class="tab-pane fade" id="dah-panel-reviews" role="tabpanel" aria-labelledby="dah-tab-reviews">
                    <t t-set="dah_rating_rows" t-value="product.dah_rating_distribution()"/>
                    <t t-set="dah_reviews" t-value="product.dah_public_reviews()"/>
                    <div class="dah-product-reviews">
                        <div class="dah-product-reviews-summary" t-if="dah_review_stats['count']">
                            <div class="dah-product-reviews-score">
                                <strong t-esc="'%0.1f' % dah_review_stats['average']">5.0</strong>
                                <span class="dah-review-stars" aria-label="Average rating"><t t-esc="'★' * int(round(dah_review_stats['average']))"/><t t-esc="'☆' * (5 - int(round(dah_review_stats['average'])))"/></span>
                            </div>
                            <p class="dah-product-reviews-note" t-esc="'Based on %s reviews' % dah_review_stats['count']"/>
                            <div class="dah-product-reviews-bars">
                                <div class="dah-rating-row" t-foreach="dah_rating_rows" t-as="row">
                                    <span class="dah-rating-star" t-esc="row['stars']"/>
                                    <span class="dah-rating-bar">
                                        <span class="dah-rating-fill" t-attf-style="width:{row['percentage']}%;"/>
                                    </span>
                                    <span class="dah-rating-pct" t-esc="str(row['percentage']) + '%'"/>
                                </div>
                            </div>
                        </div>
                        <div class="dah-product-reviews-empty" t-if="not dah_review_stats['count']">
                            Be the first to review this product.
                        </div>

                        <form class="dah-review-form" action="/dah/product/review" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="product_id" t-att-value="product.id"/>
                            <h4>Write a Review</h4>
                            <div class="dah-review-success" t-if="request.httprequest.args.get('reviewed') == '1'">Thank you! Your review has been published.</div>
                            <label for="dah_review_rating">Your rating</label>
                            <select id="dah_review_rating" name="rating" required="required">
                                <option value="5">★★★★★ - Excellent</option><option value="4">★★★★☆ - Very good</option><option value="3">★★★☆☆ - Good</option><option value="2">★★☆☆☆ - Fair</option><option value="1">★☆☆☆☆ - Poor</option>
                            </select>
                            <label for="dah_review_comment">Your review</label>
                            <textarea id="dah_review_comment" name="comment" rows="4" maxlength="2000" required="required" placeholder="Share your experience with this product..."></textarea>
                            <small t-if="request.env.user._is_public()">Your review will appear as Guest.</small>
                            <small t-else="">Your review will appear as <strong t-esc="request.env.user.partner_id.name"/>.</small>
                            <button type="submit">Submit Review</button>
                        </form>

                        <div class="dah-review-list" t-if="dah_reviews">
                            <article class="dah-review-card" t-foreach="dah_reviews" t-as="review">
                                <div class="dah-review-head"><strong t-esc="review.name"/><span class="dah-review-stars"><t t-esc="'★' * review.rating"/><t t-esc="'☆' * (5 - review.rating)"/></span></div>
                                <p t-esc="review.comment"/>
                                <time t-esc="review.create_date.strftime('%d %b %Y')"/>
                            </article>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </xpath>

</template>

<!-- ── 4b. WhatsApp order button (the add-to-cart anchor lives in cta_wrapper) ── -->
<template id="dar_al_hadaya_product_cta_wrapper" inherit_id="website_sale.cta_wrapper" name="Dar Al Hadaya WhatsApp Order Button">
    <xpath expr="//a[@id='add_to_cart']" position="after">
        <button type="button" class="dah-order-whatsapp" id="dah_order_whatsapp" aria-label="Order this product by WhatsApp">
            <i class="fa fa-whatsapp" aria-hidden="true"></i>
            <span>Order by WhatsApp</span>
        </button>
    </xpath>
</template>

<!-- ── 5. "You May Also Like" title for the alternative products strip ── -->
<template id="dar_al_hadaya_alternative_products" inherit_id="website_sale.alternative_products" name="Dar Al Hadaya You May Also Like">
    <xpath expr="//section[hasclass('s_dynamic_snippet_title')]//h4" position="replace">
        <h4>You May Also Like</h4>
    </xpath>
    <xpath expr="//section[hasclass('s_dynamic_snippet_title')]//p" position="replace"/>
</template>

</data>
</odoo>
