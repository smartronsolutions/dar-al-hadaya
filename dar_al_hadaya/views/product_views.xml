<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dar_al_hadaya_product_form" model="ir.ui.view">
        <field name="name">dar.al.hadaya.product.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <page name="sales" position="after">
                <page string="Website (Dar Al Hadaya)" name="dar_al_hadaya">
                    <group string="Product Media">
                        <group>
                            <field name="dah_video_url"
                                   placeholder="e.g. https://www.yourdomain.com/videos/reel.mp4"/>
                        </group>
                        <group>
                            <field name="dah_featured"/>
                            <field name="dah_is_addon"/>
                        </group>
                    </group>
                    <group string="Gifting Copy">
                        <field name="dah_short_description"
                               placeholder="One or two sentences shown below the order buttons."/>
                        <field name="dah_details_contents"/>
                        <field name="dah_product_information"/>
                    </group>
                    <group string="Order Sidebar">
                        <field name="dah_recommended_addon_ids"
                               widget="many2many_tags"
                               options="{'no_create_edit': True}"
                               help="Suggested add-ons shown in the order sidebar when this product is in the cart."/>
                    </group>
                </page>
            </page>
        </field>
    </record>

    <!-- Client manages one category only. It is synced to public_categ_ids by Python. -->
    <record id="dar_al_hadaya_hide_public_category" model="ir.ui.view">
        <field name="name">dar.al.hadaya.hide.public.category</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="website_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="public_categ_ids" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="categ_id" position="attributes">
                <attribute name="string">Category</attribute>
            </field>
        </field>
    </record>
</odoo>
