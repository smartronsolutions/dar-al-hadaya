<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dar_al_hadaya_public_category_form" model="ir.ui.view">
        <field name="name">dar.al.hadaya.public.category.form</field>
        <field name="model">product.public.category</field>
        <field name="inherit_id" ref="website_sale.product_public_category_form_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="dah_for_dar_al_hadaya" widget="boolean_toggle"/>
            </field>
        </field>
    </record>

    <record id="dar_al_hadaya_public_category_list" model="ir.ui.view">
        <field name="name">dar.al.hadaya.public.category.list</field>
        <field name="model">product.public.category</field>
        <field name="inherit_id" ref="website_sale.product_public_category_tree_view"/>
        <field name="arch" type="xml">
            <field name="display_name" position="after">
                <field name="dah_for_dar_al_hadaya" widget="boolean_toggle"/>
            </field>
        </field>
    </record>

    <record id="dar_al_hadaya_product_form" model="ir.ui.view">
        <field name="name">dar.al.hadaya.product.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="dah_occasion_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
                <field name="dah_personalized"/>
            </field>
            <group name="sale" position="inside">
                <group string="Dar Al Hadaya Video">
                    <field name="dah_video_type" widget="radio" options="{'horizontal': true}"/>
                    <field name="dah_video_url"
                           placeholder="YouTube, Instagram or Facebook video link"
                           invisible="dah_video_type != 'link'"/>
                    <field name="dah_video_file"
                           filename="dah_video_filename"
                           options="{'accepted_file_extensions': '.mp4,.webm,.ogg'}"
                           invisible="dah_video_type != 'upload'"/>
                    <field name="dah_video_filename" invisible="1"/>
                </group>
                <group string="Details, Contents &amp; Size">
                    <field name="dah_details_contents"
                           string="Details, Contents &amp; Size"
                           widget="html"
                           colspan="2"
                           placeholder="Enter product details, box contents and size..."/>
                </group>
            </group>
        </field>
    </record>

    <record id="dar_al_hadaya_occasion_list" model="ir.ui.view">
        <field name="name">dah.occasion.list</field>
        <field name="model">dah.occasion</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="product_count" string="Products"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="dar_al_hadaya_occasion_form" model="ir.ui.view">
        <field name="name">dah.occasion.form</field>
        <field name="model">dah.occasion</field>
        <field name="arch" type="xml">
            <form string="Occasion">
                <sheet>
                    <group><field name="name"/><field name="sequence"/><field name="active"/></group>
                    <field name="product_ids" widget="many2many_tags"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dar_al_hadaya_occasion_action" model="ir.actions.act_window">
        <field name="name">Occasions</field>
        <field name="res_model">dah.occasion</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Client manages one category only. It is synced to public_categ_ids by Python. -->
    <record id="dar_al_hadaya_hide_public_category" model="ir.ui.view">
        <field name="name">dar.al.hadaya.hide.public.category</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="website_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="public_categ_ids" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="categ_id" position="attributes">
                <attribute name="string">Category</attribute>
            </field>
        </field>
    </record>

    <!-- Show the website customization text on the sale order line. -->
    <record id="dar_al_hadaya_sale_order_form_customization" model="ir.ui.view">
        <field name="name">dar.al.hadaya.sale.order.form.customization</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="dah_customer_name" readonly="1" invisible="not dah_customer_name"/>
                <field name="dah_whatsapp_number" readonly="1" invisible="not dah_whatsapp_number"/>
            </field>
            <xpath expr="//field[@name='order_line']/form//field[@name='name']" position="after">
                <field name="dah_customization"
                       string="Customization"
                       placeholder="Customer customization..."
                       invisible="display_type"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="after">
                <field name="dah_customization" string="Customization" optional="show" invisible="display_type"/>
            </xpath>
        </field>
    </record>

    <record id="dar_al_hadaya_sale_order_line_tree_customization" model="ir.ui.view">
        <field name="name">dar.al.hadaya.sale.order.line.tree.customization</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_order_line_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="dah_customization" string="Customization" optional="show"/>
            </field>
        </field>
    </record>

    <record id="dar_al_hadaya_sale_order_line_form_customization" model="ir.ui.view">
        <field name="name">dar.al.hadaya.sale.order.line.form.customization</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.sale_order_line_view_form_readonly"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="dah_customization" string="Customization"/>
            </field>
        </field>
    </record>

    <record id="dar_al_hadaya_invoice_form_customization" model="ir.ui.view">
        <field name="name">dar.al.hadaya.invoice.form.customization</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='name']" position="after">
                <field name="dah_customization" string="Customization" optional="show"/>
            </xpath>
        </field>
    </record>

    <template id="dar_al_hadaya_invoice_report_customization" inherit_id="account.report_invoice_document">
        <xpath expr="//td[@name='account_invoice_line_name']/span[@t-field='line.name']" position="after">
            <div t-if="line.dah_customization" class="small"><strong>Customization:</strong> <span t-esc="line.dah_customization"/></div>
        </xpath>
    </template>

    <template id="dar_al_hadaya_sale_report_customization" inherit_id="sale.report_saleorder_document">
        <xpath expr="//td[@name='td_product_name']/span[@t-field='line.name']" position="after">
            <div t-if="line.dah_customization" class="small"><strong>Customization:</strong> <span t-esc="line.dah_customization"/></div>
        </xpath>
    </template>
</odoo>
