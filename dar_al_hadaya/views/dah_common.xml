<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

<!-- ══════════════════════════════════════════════════════════════════
     DAR AL HADAYA — COMMON WEBSITE ELEMENTS
     Global layout pieces that appear on every website page, in the same
     spirit as biighands_website/views/bh_common.xml:

       1. dar_al_hadaya_common_layout   -> custom header + footer
                                           (native Odoo header hidden,
                                            native footer replaced)
       2. dar_al_hadaya_cart_sidebar    -> order sidebar + overlay
                                           ("Your Order" / "Add a Little
                                            Extra" / Place Order on
                                            WhatsApp)

     Styling lives in ../static/src/css/dar_al_hadaya.css and behaviour
     in ../static/src/js/dar_al_hadaya.js (loaded globally through the
     manifest assets).
     ══════════════════════════════════════════════════════════════════ -->

<!-- ══════════════════════════════════════════════════════════════════
     1. GLOBAL HEADER + FOOTER
     ══════════════════════════════════════════════════════════════════ -->
<template id="dar_al_hadaya_common_layout" inherit_id="website.layout" name="Dar Al Hadaya Common Layout">

    <!-- Keep the responsive mobile storefront at its designed scale. -->
    <xpath expr="//meta[@name='viewport']" position="attributes">
        <attribute name="content">width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no</attribute>
    </xpath>

    <xpath expr="//head" position="inside">
        <link rel="preconnect" href="https://fonts.googleapis.com"/>
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,100..900&amp;display=swap"/>
    </xpath>

    <!-- Hide the native Odoo header -->
    <xpath expr="//header" position="attributes">
        <attribute name="style">display:none !important</attribute>
    </xpath>

    <!-- ── Custom header ──
         Design source: Dar Al Hadaya responsive header spec.
         Top bar: menu button + search (left), centered DAR AL HADAYA
         brand with Arabic subtitle (right-to-left), WhatsApp + Cart
         (right). Below: green gradient nav (HOME, GIFTS, OCCASIONS,
         CUSTOM GIFTS, ISLAMIC GIFTS, NEW BABY, ABOUT US, CONTACT US). -->
    <xpath expr="//header" position="before">
        <header class="dah-site-header" id="dah_site_header">
            <t t-set="dah_company" t-value="website.company_id"/>
            <div class="dah-topbar">

                <button class="dah-menu-btn" id="dah_menu_btn" type="button" aria-label="Open menu" aria-expanded="false">
                    <span></span><span></span><span></span>
                </button>

                <form class="dah-search dah-desktop-search" action="/shop" method="get" role="search" autocomplete="off">
                    <svg class="dah-icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m16.2 16.2 4 4"/></svg>
                    <input id="dah_desktop_search_input" type="search" name="search" placeholder="Search gifts..." aria-label="Search gifts" aria-controls="dah_desktop_search_suggestions" aria-autocomplete="list"/>
                    <button class="dah-desktop-search-button" type="submit">SEARCH</button>
                    <div class="dah-desktop-search-suggestions" id="dah_desktop_search_suggestions" role="listbox" aria-live="polite"></div>
                </form>

                <a class="dah-brand" href="/" aria-label="Dar Al Hadaya home">
                    <img class="dah-brand-logo-img" src="/dar_al_hadaya/static/images/logo.png" alt="Dar Al Hadaya"/>
                </a>

                <div class="dah-actions">
                    <a class="dah-action" href="https://wa.me/97433344765" id="dah_wa_link" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
                        <i class="fa fa-whatsapp dah-header-whatsapp-icon" aria-hidden="true"/>
                        <span>WhatsApp</span>
                    </a>
                    <a
                        class="dah-action dah-desktop-account"
                        t-if="request.env.user._is_public()"
                        href="/web/login?redirect=/my/home"
                        aria-label="Sign in"
                    >
                        <svg class="dah-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="7.5" r="3.5"/>
                            <path d="M5.5 20v-2.2c0-3.2 2.9-5.8 6.5-5.8s6.5 2.6 6.5 5.8V20"/>
                        </svg>
                        <span>Sign In</span>
                    </a>
                    <a
                        class="dah-action dah-desktop-account"
                        t-else=""
                        href="/my/home"
                        aria-label="Open my account dashboard"
                    >
                        <svg class="dah-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="7.5" r="3.5"/>
                            <path d="M5.5 20v-2.2c0-3.2 2.9-5.8 6.5-5.8s6.5 2.6 6.5 5.8V20"/>
                        </svg>
                        <span>My Account</span>
                    </a>
                    <button class="dah-action" id="dah_cart_btn" type="button" aria-label="Cart">
                        <svg class="dah-icon" viewBox="0 0 24 24"><path d="M2.5 4h2l2.1 10.2h10.8l2-7.2H6"/><circle cx="9" cy="18.5" r="1.2"/><circle cx="17" cy="18.5" r="1.2"/></svg>
                        <b class="dah-cart-count" id="dah_cart_badge">0</b>
                        <span>Cart</span>
                    </button>
                </div>
            </div>

            <form class="dah-mobile-search dah-mobile-banner-search" action="/shop" method="get" role="search" autocomplete="off">
                <label class="dah-mobile-search-field" for="dah_mobile_search_input">
                    <svg class="dah-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16.2 16.2 4 4"/></svg>
                    <input id="dah_mobile_search_input" type="search" name="search" placeholder="Search gifts..." aria-label="Search gifts" aria-controls="dah_mobile_search_suggestions" aria-autocomplete="list"/>
                </label>
                <button type="submit">SEARCH</button>
                <div class="dah-mobile-search-suggestions" id="dah_mobile_search_suggestions" role="listbox" aria-live="polite"></div>
            </form>

            <nav class="dah-nav" aria-label="Main navigation">
                <div class="dah-nav-inner">
                    <div class="dah-mobile-menu-head">
                        <a class="dah-mobile-menu-logo" href="/" aria-label="Dar Al Hadaya home">
                            <img src="/dar_al_hadaya/static/images/logo-mobile-menu.png" alt="Dar Al Hadaya"/>
                        </a>
                        <button type="button" id="dah_menu_close" aria-label="Close menu">&#215;</button>
                    </div>
                    <t t-set="dah_public_categories" t-value="request.env['product.public.category'].sudo().search([('name', 'in', ['Occasions', 'Custom Gifts', 'Islamic Gifts', 'Newborn &amp; Baby Gifts', 'Graduation Gifts', 'Wedding &amp; Marriage Gifts'])])"/>
                    <t t-set="dah_occasions" t-value="dah_public_categories.filtered(lambda category: category.name == 'Occasions')[:1]"/>
                    <t t-set="dah_custom_gifts" t-value="dah_public_categories.filtered(lambda category: category.name == 'Custom Gifts')[:1]"/>
                    <t t-set="dah_islamic_gifts" t-value="dah_public_categories.filtered(lambda category: category.name == 'Islamic Gifts')[:1]"/>
                    <t t-set="dah_new_baby" t-value="dah_public_categories.filtered(lambda category: category.name == 'Newborn &amp; Baby Gifts')[:1]"/>
                    <t t-set="dah_graduation" t-value="dah_public_categories.filtered(lambda category: category.name == 'Graduation Gifts')[:1]"/>
                    <t t-set="dah_wedding" t-value="dah_public_categories.filtered(lambda category: category.name == 'Wedding &amp; Marriage Gifts')[:1]"/>
                    <t t-set="dah_navigation_products" t-value="request.env['product.template'].sudo().search(website.sale_product_domain())"/>
                    <t t-set="dah_navigation_occasions" t-value="dah_navigation_products.mapped('dah_occasion_ids').filtered('active').sorted(key=lambda occasion: (occasion.sequence, (occasion.name or '').lower(), occasion.id))"/>
                    <t t-set="dah_mobile_categories" t-value="request.env['product.public.category'].sudo().search([('dah_for_dar_al_hadaya', '=', True), ('website_id', 'in', [False, website.id])], order='sequence, name, id')"/>
                    <div class="dah-mobile-only">
                        <div class="dah-mobile-nav-list">
                            <a class="dah-mobile-nav-row" href="/"><i class="fa fa-home"/><span>HOME</span></a>
                            <div class="dah-mobile-nav-group">
                                <button class="dah-mobile-nav-row dah-mobile-submenu-toggle" type="button" aria-expanded="false"><i class="fa fa-th-large"/><span>CATEGORY</span><i class="fa fa-angle-right dah-mobile-row-arrow"/></button>
                                <div class="dah-mobile-submenu">
                                    <a href="/shop">All Products</a>
                                    <a t-foreach="dah_mobile_categories" t-as="category" t-att-href="'/shop/category/%s' % slug(category)" t-out="category.name"/>
                                </div>
                            </div>
                            <div class="dah-mobile-nav-group">
                                <button class="dah-mobile-nav-row dah-mobile-submenu-toggle" type="button" aria-expanded="false"><i class="fa fa-share-alt"/><span>SOCIAL MEDIA</span><i class="fa fa-angle-right dah-mobile-row-arrow"/></button>
                                <div class="dah-mobile-submenu dah-mobile-social-submenu">
                                    <a id="dah_mobile_wa_link" href="https://wa.me/97433344765" target="_blank" rel="noopener"><i class="fa fa-whatsapp"/><span>WhatsApp</span></a>
                                    <a href="https://www.instagram.com/daralhadaya" target="_blank" rel="noopener"><i class="fa fa-instagram"/><span>Instagram</span></a>
                                    <a href="https://www.tiktok.com/@daralhadaya" target="_blank" rel="noopener"><svg class="dah-tiktok-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M15.2 3c.35 2.15 1.55 3.43 3.8 3.56v3.06a8.28 8.28 0 0 1-3.76-1.1v6.13a6.18 6.18 0 1 1-5.34-6.12v3.14a3.08 3.08 0 1 0 2.22 2.96V3h3.08Z"/></svg><span>TikTok</span></a>
                                    <a href="https://www.facebook.com/share/1Bmkr4Q92N/?mibextid=wwXIfr" target="_blank" rel="noopener"><i class="fa fa-facebook"/><span>Facebook</span></a>
                                </div>
                            </div>
                            <button class="dah-mobile-nav-row" id="dah_mobile_menu_cart" type="button"><i class="fa fa-shopping-cart"/><span>CART</span></button>
                        </div>
                    </div>
                    <div class="dah-desktop-nav-links">
                        <a href="/">HOME</a><a href="/shop">GIFTS</a>
                        <div class="dah-desktop-nav-group" t-if="dah_navigation_occasions">
                            <button class="dah-desktop-nav-toggle" type="button">OCCASIONS <i class="fa fa-angle-down"/></button>
                            <div class="dah-desktop-nav-dropdown"><a t-foreach="dah_navigation_occasions" t-as="occasion" t-att-href="'/shop?occasion=%s' % occasion.id" t-out="occasion.name"/></div>
                        </div>
                        <a t-att-href="dah_custom_gifts and '/shop/category/%s' % slug(dah_custom_gifts) or '/shop'">CUSTOM GIFTS</a>
                        <a t-att-href="dah_islamic_gifts and '/shop/category/%s' % slug(dah_islamic_gifts) or '/shop'">ISLAMIC GIFTS</a>
                        <a t-att-href="dah_new_baby and '/shop/category/%s' % slug(dah_new_baby) or '/shop'">NEW BABY</a>
                        <a href="/contactus">CONTACT US</a>
                    </div>
                </div>
            </nav>
            <button type="button" class="dah-menu-overlay" id="dah_menu_overlay" aria-label="Close menu"></button>
            <div class="dah-mobile-dock-search-panel" id="dah_mobile_dock_search_panel">
                <form action="/shop" method="get" role="search" autocomplete="off">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg>
                    <input id="dah_dock_search_input" type="search" name="search" placeholder="Search gifts..." aria-label="Search products" aria-controls="dah_dock_search_suggestions"/>
                    <button type="submit">SEARCH</button>
                    <div class="dah-mobile-search-suggestions" id="dah_dock_search_suggestions" role="listbox" aria-live="polite"></div>
                </form>
            </div>
            <nav class="dah-mobile-category-dock" aria-label="Mobile navigation">
                <a href="/" t-att-class="'dah-active' if request.httprequest.path == '/' else ''">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 11 9-8 9 8M5.5 9.5V21h13V9.5M9.5 21v-7h5v7"/></svg>
                    <span>Home</span>
                </a>
                <a href="/shop" t-att-class="'dah-active' if request.httprequest.path.startswith('/shop') else ''">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16l-1 13H5L4 8ZM8 9V6a4 4 0 0 1 8 0v3"/></svg>
                    <span>Shop</span>
                </a>
                <button type="button" id="dah_mobile_dock_search" aria-label="Search products">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg>
                    <span>Search</span>
                </button>
                <button type="button" id="dah_mobile_dock_cart" aria-label="Open cart">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 4h2l2.1 10.2h10.8l2-7.2H6"/><circle cx="9" cy="18.5" r="1.2"/><circle cx="17" cy="18.5" r="1.2"/></svg>
                    <span>Cart</span>
                </button>
                <a href="https://wa.me/97433344765" target="_blank" rel="noopener">
                    <i class="fa fa-whatsapp" aria-hidden="true"/>
                    <span>WhatsApp</span>
                </a>
            </nav>
        </header>
    </xpath>

    <!-- Keep the native nodes available to dependent inherited views, but hide the extra strip. -->
    <xpath expr="//div[hasclass('o_footer_copyright')]" position="attributes">
        <attribute name="class" add="d-none" separator=" "/>
        <attribute name="aria-hidden">true</attribute>
    </xpath>

    <!-- Responsive global footer, backed by Odoo website/company data. -->
    <xpath expr="//div[@id='footer']" position="replace">
        <div id="footer" class="dah_footer" t-if="not no_footer">
            <t t-set="dah_footer_categories" t-value="request.env['product.public.category'].sudo().search([('name', 'in', ['Occasions', 'Custom Gifts', 'Islamic Gifts', 'Newborn &amp; Baby Gifts'])])"/>
            <t t-set="dah_footer_occasions" t-value="dah_footer_categories.filtered(lambda category: category.name == 'Occasions')[:1]"/>
            <t t-set="dah_footer_custom" t-value="dah_footer_categories.filtered(lambda category: category.name == 'Custom Gifts')[:1]"/>
            <t t-set="dah_footer_islamic" t-value="dah_footer_categories.filtered(lambda category: category.name == 'Islamic Gifts')[:1]"/>
            <t t-set="dah_footer_company" t-value="website.company_id"/>

            <div class="dah_footer_ctas">
                <a class="dah_footer_cta" href="/shop">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l1 13H4L5 8Z"/><path d="M8 9V6a4 4 0 0 1 8 0v3"/></svg>
                    <span>Shop Gifts</span><span class="dah_footer_arrow">&#8594;</span>
                </a>
                <a class="dah_footer_cta" href="https://wa.me/97433344765" id="dah_footer_wa_link" target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 11.7a8.4 8.4 0 0 1-12.4 7.4L3.5 20.5l1.4-4.4a8.4 8.4 0 1 1 15.6-4.4Z"/><path d="M8.2 7.7c.4-.5.7-.3 1 .2l.8 1.7c.2.4-.2.8-.6 1.2.8 1.7 2 2.8 3.8 3.5.4-.5.8-1.1 1.2-1 .7.2 1.6.7 2 .9.5.2.5.7.3 1.1-.5 1.1-1.7 1.6-2.8 1.3-3.8-.8-6.8-3.6-7.6-6.2-.3-1 .7-2.4 1.9-2.7Z"/></svg>
                    <span>Chat on WhatsApp</span><span class="dah_footer_arrow">&#8594;</span>
                </a>
            </div>

            <footer class="dah_footer_body">
                <div class="dah_footer_main">
                    <section class="dah_footer_brand">
                        <a class="dah_footer_logo" href="/" aria-label="Dar Al Hadaya home">
                            <img class="dah_footer_logo_img" src="/dar_al_hadaya/static/images/logo.png" alt="Dar Al Hadaya" loading="lazy"/>
                        </a>
                        <p>Thoughtful gifts for every occasion. Personalized with love, delivered with care.</p>
                        <div class="dah_footer_socials">
                            <a href="https://wa.me/97433344765" id="dah_footer_social_wa" aria-label="WhatsApp" target="_blank" rel="noopener"><i class="fa fa-whatsapp"/></a>
                            <a href="https://www.instagram.com/daralhadaya" aria-label="Instagram" target="_blank" rel="noopener"><i class="fa fa-instagram"/></a>
                            <a href="https://www.tiktok.com/@daralhadaya" aria-label="TikTok" target="_blank" rel="noopener">
                                <svg class="dah-tiktok-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M15.2 3c.35 2.15 1.55 3.43 3.8 3.56v3.06a8.28 8.28 0 0 1-3.76-1.1v6.13a6.18 6.18 0 1 1-5.34-6.12v3.14a3.08 3.08 0 1 0 2.22 2.96V3h3.08Z"/>
                                </svg>
                            </a>
                            <a href="https://www.facebook.com/share/1Bmkr4Q92N/?mibextid=wwXIfr" aria-label="Facebook" target="_blank" rel="noopener"><i class="fa fa-facebook"/></a>
                        </div>
                    </section>

                    <section class="dah_footer_group">
                        <h3>QUICK LINKS</h3><button class="dah_footer_toggle" type="button" aria-expanded="false">QUICK LINKS</button>
                        <div class="dah_footer_content"><ul>
                            <li><a href="/">Home</a></li><li><a href="/shop">Gifts</a></li>
                            <li><a t-att-href="dah_footer_occasions and '/shop/category/%s' % slug(dah_footer_occasions) or '/shop'">Occasions</a></li>
                            <li><a t-att-href="dah_footer_custom and '/shop/category/%s' % slug(dah_footer_custom) or '/shop'">Custom Gifts</a></li>
                            <li><a t-att-href="dah_footer_islamic and '/shop/category/%s' % slug(dah_footer_islamic) or '/shop'">Islamic Gifts</a></li>
                        </ul></div>
                    </section>

                    <section class="dah_footer_group">
                        <h3>INFO</h3><button class="dah_footer_toggle" type="button" aria-expanded="false">INFO</button>
                        <div class="dah_footer_content"><ul>
                            <li><a href="/terms-conditions">Terms &amp; Conditions</a></li>
                            <li><a href="/privacy">Privacy Policy</a></li>
                            <li><a href="/refund-policy">Refund Policy</a></li>
                            <li><a href="/blog">Blog</a></li>
                        </ul></div>
                    </section>

                    <section class="dah_footer_group">
                        <h3>CONTACT US</h3><button class="dah_footer_toggle" type="button" aria-expanded="false">CONTACT US</button>
                        <div class="dah_footer_content dah_footer_contact">
                            <div class="dah_footer_contact_item" t-if="dah_footer_company.phone">
                                <i class="fa fa-phone"/><a t-att-href="'tel:%s' % dah_footer_company.phone.replace(' ', '')" t-esc="dah_footer_company.phone"/>
                            </div>
                            <div class="dah_footer_contact_item" t-if="dah_footer_company.email">
                                <i class="fa fa-envelope-o"/><a t-att-href="'mailto:%s' % dah_footer_company.email" t-esc="dah_footer_company.email"/>
                            </div>
                            <div class="dah_footer_contact_item" t-if="dah_footer_company.city or dah_footer_company.country_id">
                                <i class="fa fa-map-marker"/><span><t t-esc="dah_footer_company.city"/><t t-if="dah_footer_company.city and dah_footer_company.country_id">, </t><t t-esc="dah_footer_company.country_id.name"/></span>
                            </div>
                            <a class="dah_footer_contact_fallback" href="/contactus" t-if="not (dah_footer_company.phone or dah_footer_company.email or dah_footer_company.city)">Contact our team</a>
                        </div>
                    </section>
                </div>

                <nav class="dah_footer_mobile_socials" aria-label="Social media links">
                    <a href="https://wa.me/97433344765" id="dah_footer_mobile_social_wa" aria-label="WhatsApp" target="_blank" rel="noopener"><i class="fa fa-whatsapp"/></a>
                    <a href="https://www.instagram.com/daralhadaya" aria-label="Instagram" target="_blank" rel="noopener"><i class="fa fa-instagram"/></a>
                    <a href="https://www.facebook.com/share/1Bmkr4Q92N/?mibextid=wwXIfr" aria-label="Facebook" target="_blank" rel="noopener"><i class="fa fa-facebook"/></a>
                    <a href="https://www.tiktok.com/@daralhadaya" aria-label="TikTok" target="_blank" rel="noopener"><svg class="dah-tiktok-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M15.2 3c.35 2.15 1.55 3.43 3.8 3.56v3.06a8.28 8.28 0 0 1-3.76-1.1v6.13a6.18 6.18 0 1 1-5.34-6.12v3.14a3.08 3.08 0 1 0 2.22 2.96V3h3.08Z"/></svg></a>
                </nav>

                <div class="dah_footer_bottom">
                    <nav class="dah_footer_legal" aria-label="Footer legal links">
                        <a href="/terms-conditions">Terms &amp; Conditions</a>
                        <a href="/privacy">Privacy Policy</a>
                        <a href="/refund-policy">Refund Policy</a>
                        <a href="/blog">Blog</a>
                    </nav>
                    <span>&#169; <span id="dah_footer_year">2026</span> DAR AL HADAYA. All rights reserved.</span>
                    <div class="dah_footer_payments" aria-label="Accepted payment methods">
                        <img class="dah_footer_payment_logos" src="/dar_al_hadaya/static/src/img/payments/payments.png" alt="Mastercard, Visa, Apple Pay and Google Pay" loading="lazy"/>
                    </div>
                </div>
            </footer>
            <button class="dah_back_top" id="dah_back_top" type="button" aria-label="Back to top"><i class="fa fa-angle-up"/></button>
        </div>
    </xpath>
</template>

<!-- ══════════════════════════════════════════════════════════════════
     2. ORDER SIDEBAR
     The customer is never taken to a traditional cart page: adding a
     product opens this simple side panel with product image, name,
     price, quantity controls, customer name + WhatsApp number and the
     Place Order action.
     ══════════════════════════════════════════════════════════════════ -->
<template id="dar_al_hadaya_cart_sidebar" inherit_id="website.layout" name="Dar Al Hadaya Order Sidebar">

    <xpath expr="//div[@id='wrapwrap']" position="inside">
        <div class="dah_cart_overlay" id="dah_cart_overlay"></div>

        <aside class="dah_cart_sidebar" id="dah_cart_sidebar" aria-label="Your order">
            <div class="dah_cart_head">
                <h3>My Cart</h3>
                <button type="button" class="dah_icon_btn dah_cart_close" id="dah_cart_close" aria-label="Close order panel">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>

            <div class="dah_cart_body">
                <!-- Your Order: filled by JS from /dah/cart/data -->
                <div class="dah_cart_items" id="dah_cart_items">
